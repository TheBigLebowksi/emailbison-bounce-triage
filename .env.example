# All optional. Set them as environment variables (the tool does not read a .env file itself).
# With none set, it runs fully offline.

# Post the Slack summary to YOUR OWN incoming webhook.
SLACK_WEBHOOK_URL=

# LLM summary + suggestions for unknown bounces (never used in the verdict).
ANTHROPIC_API_KEY=

# Only for --dns live: Spamhaus DQS key (else the public mirror is used).
SPAMHAUS_DQS_KEY=

# serve mode: require /webhook?token=...
WEBHOOK_TOKEN=
