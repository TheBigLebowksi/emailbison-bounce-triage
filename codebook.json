{
 "version": "2026-10-29",
 "notes": "Matched against the remote server's response (diagnostic text), not the whole NDR. An entry matches when every field it sets matches: provider (who rejected), basic (550), enhanced (5.1.1 or a range), tag (Yahoo [TSS04]), text (case-insensitive regex). The most specific match wins. Categories map to the 8 causes in rules.json, plus 'unknown'. 'headlines' match the human-readable notice itself and are used only when nothing else matches, e.g. when a sequencer cuts the text off before the server's response. They count as weaker evidence than a code.",
 "sources": {
  "google": "https://knowledge.workspace.google.com/admin/support/troubleshooting/gmail-smtp-errors-and-codes",
  "microsoft": "https://learn.microsoft.com/en-us/exchange/mail-flow-best-practices/non-delivery-reports-in-exchange-online/non-delivery-reports-in-exchange-online",
  "microsoft_515": "https://support.microsoft.com/en-us/outlook/fix-ndr-error-550-5-7-515-in-outlook-com",
  "yahoo": "https://senders.yahooinc.com/smtp-error-codes/",
  "mimecast": "https://mimecastsupport.zendesk.com/hc/en-us/articles/34000623043987-Content-Examination-Policy",
  "proofpoint": "https://ipcheck.proofpoint.com",
  "barracuda": "https://www.barracudacentral.org/rbl",
  "spamhaus": "https://www.spamhaus.org/blocklists/",
  "rfc3463": "https://www.rfc-editor.org/rfc/rfc3463",
  "highticketai": "https://highticketaisystems.com/blog/cold-email-bounce-rate-causes-fixes",
  "revsculpt": "https://revsculpt.com/articles/cold-email-bounce-rate"
